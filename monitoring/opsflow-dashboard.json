{
  "uid": "opsflow-operations",
  "title": "OpsFlow Operations",
  "description": "Real metrics from independently scraped backend replicas. API panels exclude operational probes.",
  "tags": [
    "opsflow",
    "minikube"
  ],
  "schemaVersion": 39,
  "version": 2,
  "editable": false,
  "timezone": "browser",
  "refresh": "15s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "Backend scrape targets UP",
      "description": "",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "opsflow-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(up{job=\"opsflow-backend\"})",
          "legendFormat": "Backend scrape targets UP",
          "range": false,
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none"
      }
    },
    {
      "id": 2,
      "title": "Incident API requests — selected period",
      "description": "Windowed increase; may be fractional due to Prometheus extrapolation.",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "opsflow-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(http_requests_total{job=\"opsflow-backend\",handler=~\"/api/.*\"}[$__range]))",
          "legendFormat": "Incident API requests — selected period",
          "range": false,
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none"
      }
    },
    {
      "id": 3,
      "title": "Incident API request rate",
      "description": "",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "opsflow-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(http_requests_total{job=\"opsflow-backend\",handler=~\"/api/.*\"}[$__rate_interval]))",
          "legendFormat": "Incident API request rate",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 4,
      "title": "Incident API requests by method / status class",
      "description": "Status labels are classes such as 2xx and 4xx, not individual HTTP codes.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "opsflow-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (method, status) (increase(http_requests_total{job=\"opsflow-backend\",handler=~\"/api/.*\"}[$__range]))",
          "legendFormat": "{{method}} {{status}}",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 5,
      "title": "Mean incident API latency by handler",
      "description": "No requests in a window can produce gaps; latency is a mean, not a percentile.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "opsflow-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (handler) (rate(http_request_duration_seconds_sum{job=\"opsflow-backend\",handler=~\"/api/.*\"}[$__rate_interval])) / sum by (handler) (rate(http_request_duration_seconds_count{job=\"opsflow-backend\",handler=~\"/api/.*\"}[$__rate_interval]))",
          "legendFormat": "{{handler}}",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 6,
      "title": "Backend process CPU usage (cores)",
      "description": "CPU used by each Python process, not total Kubernetes pod CPU.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "opsflow-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 20,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (pod) (rate(process_cpu_seconds_total{job=\"opsflow-backend\"}[$__rate_interval]))",
          "legendFormat": "{{pod}}",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 7,
      "title": "Backend process resident memory",
      "description": "Resident memory of each Python process, not total Kubernetes pod memory.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "opsflow-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 20,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (pod) (process_resident_memory_bytes{job=\"opsflow-backend\"})",
          "legendFormat": "{{pod}}",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    }
  ],
  "annotations": {
    "list": []
  }
}
