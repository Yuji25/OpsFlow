# Local demo only. Copy to terraform.tfvars (ignored); never include credentials.
aws_region         = "ap-south-1"
cluster_name       = "opsflow-eks"
vpc_name           = "opsflow-vpc"
environment        = "demo"
kubernetes_version = "1.36"
node_instance_type = "t3.medium"

# REPLACE with your actual administrator public IPv4 /32 before planning.
# Documentation-only address, not a usable administrator endpoint allowlist.
admin_cidr = "203.0.113.10/32"

availability_zones  = ["ap-south-1a", "ap-south-1b"]
vpc_cidr            = "10.20.0.0/16"
public_subnet_cidrs = ["10.20.101.0/24", "10.20.102.0/24"]
